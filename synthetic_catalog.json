[
  {
    "slug": "ACME_CREATE_AN_ORDER",
    "name": "Create an Order",
    "description": "Creates a new order and returns the created order record.",
    "toolkit": "acme_orders",
    "inputParameters": {
      "properties": {
        "customer_id": { "type": "string", "description": "The ID of the customer placing the order." },
        "total_amount": { "type": "number", "description": "The total amount of the order in cents." }
      },
      "required": ["customer_id", "total_amount"]
    },
    "outputParameters": {
      "properties": { "data": { "$ref": "#/$defs/Order" } },
      "$defs": {
        "Order": {
          "type": "object",
          "properties": {
            "number": { "type": "integer", "description": "Unique order number." },
            "status": { "type": "string" },
            "customer_id": { "type": "string" }
          }
        }
      }
    }
  },
  {
    "slug": "ACME_LIST_CUSTOMER_ORDERS",
    "name": "List Customer Orders",
    "description": "Lists all orders for a given customer.",
    "toolkit": "acme_orders",
    "inputParameters": {
      "properties": {
        "customer_id": { "type": "string", "description": "The ID of the customer whose orders to list." }
      },
      "required": ["customer_id"]
    },
    "outputParameters": {
      "properties": { "data": { "$ref": "#/$defs/OrdersResponse" } },
      "$defs": {
        "OrdersResponse": {
          "type": "object",
          "properties": {
            "orders": { "type": "array", "items": { "$ref": "#/$defs/Order" } }
          }
        },
        "Order": {
          "type": "object",
          "properties": {
            "number": { "type": "integer", "description": "Unique order number." },
            "status": { "type": "string" }
          }
        }
      }
    }
  },
  {
